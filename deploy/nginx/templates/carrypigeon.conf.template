# 由官方 Nginx entrypoint 仅替换 NGINX_* 变量，保留下面的 Nginx 请求变量。
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${NGINX_SERVER_NAME};
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # 仅表示代理自身可用，不能作为应用或外部依赖的就绪证明。
    location = /healthz {
        access_log off;
        return 200;
    }

    # 管理探针不经公网代理暴露。
    location ^~ /internal/ {
        return 404;
    }

    location = /api/ws {
        proxy_pass http://${NGINX_BACKEND_WS_HOST}:${NGINX_BACKEND_WS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # 公网入口覆盖客户端伪造的转发链；后端仍需显式配置可信代理。
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://${NGINX_BACKEND_HTTP_HOST}:${NGINX_BACKEND_HTTP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
