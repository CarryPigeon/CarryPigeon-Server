<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="CarryPigeonLogging">
    <Properties>
        <!-- 职责：统一定义项目日志输出目录；可通过 -Dcp.log.home 或 CP_LOG_HOME 覆盖。 -->
        <Property name="LOG_HOME">${sys:cp.log.home:-${env:CP_LOG_HOME:-./service-logs}}</Property>
        <!-- 职责：限制压缩归档保留时间；可通过 -Dcp.log.retention 或 CP_LOG_RETENTION 覆盖。 -->
        <Property name="LOG_RETENTION">${sys:cp.log.retention:-${env:CP_LOG_RETENTION:-30d}}</Property>
        <!-- 职责：审计归档保留时间；可通过 -Dcp.log.audit-retention 或 CP_LOG_AUDIT_RETENTION 覆盖。 -->
        <Property name="AUDIT_RETENTION">${sys:cp.log.audit-retention:-${env:CP_LOG_AUDIT_RETENTION:-180d}}</Property>
        <!-- 职责：统一所有 appender 的日志时区；默认跟随项目主要部署时区，可通过 -Dcp.log.timezone 覆盖。 -->
        <Property name="LOG_TIME_ZONE">${sys:cp.log.timezone:-${env:CP_LOG_TIMEZONE:-Asia/Shanghai}}</Property>
        <!-- 职责：统一时间格式并携带时区偏移，避免不同 appender 或不同节点的时间无法对齐。 -->
        <Property name="LOG_TIME">%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}{${LOG_TIME_ZONE}}</Property>
        <!-- 职责：统一上下文字段顺序；session_id 在 HTTP 中为请求 id，在 WS 中为单帧 id。 -->
        <Property name="LOG_CONTEXT">scope=%X{scope} session_id=%X{session_id} trace_id=%X{trace_id} route=%X{route} uid=%X{uid}</Property>
        <!-- 职责：统一文本日志格式；使用 logger name 避免调用者位置解析的栈回溯成本。 -->
        <Property name="TEXT_LOG_PATTERN">${LOG_TIME} %-5level [%t] ${LOG_CONTEXT} %logger{48} - %msg%n%throwable</Property>
    </Properties>

    <Appenders>
        <!-- 控制台日志用于开发期与容器环境快速观测。 -->
        <Console name="consoleAppender" target="SYSTEM_OUT">
            <PatternLayout
                    pattern="%style{${LOG_TIME}}{bright,green} %highlight{%-5level} [%style{%t}{bright,blue}] %style{${LOG_CONTEXT}}{bright,magenta} %style{%logger{48}}{bright,yellow} - %msg%n%style{%throwable}{red}"
                    charset="UTF-8" disableAnsi="false" noConsoleNoAnsi="true"/>
        </Console>

        <!-- 全量文件日志用于完整追溯，属于固定基础设施能力。 -->
        <RollingFile name="allFileAppender"
                     fileName="${LOG_HOME}/all.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/all-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${TEXT_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="100">
                <!-- 统一清理所有 appender 的过期压缩归档，不触碰当前活动日志。 -->
                <Delete basePath="${LOG_HOME}" maxDepth="2">
                    <IfFileName regex=".*\.log\.gz"/>
                    <IfLastModified age="${LOG_RETENTION}"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- debug 日志单独分流，避免在问题排查时与其它级别混杂。 -->
        <RollingFile name="debugFileAppender"
                     fileName="${LOG_HOME}/debug.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/debug-%d{yyyy-MM-dd}-%i.log.gz">
            <Filters>
                <ThresholdFilter level="info" onMatch="DENY" onMismatch="NEUTRAL"/>
            </Filters>
            <PatternLayout pattern="${TEXT_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="100"/>
        </RollingFile>

        <!-- info 日志作为默认业务运行观察面。 -->
        <RollingFile name="infoFileAppender"
                     fileName="${LOG_HOME}/info.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/info-%d{yyyy-MM-dd}-%i.log.gz">
            <Filters>
                <ThresholdFilter level="warn" onMatch="DENY" onMismatch="NEUTRAL"/>
            </Filters>
            <PatternLayout pattern="${TEXT_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="100"/>
        </RollingFile>

        <!-- warn 日志单独分流，用于保留需要关注但未失败的运行信号。 -->
        <RollingFile name="warnFileAppender"
                     fileName="${LOG_HOME}/warn.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/warn-%d{yyyy-MM-dd}-%i.log.gz">
            <Filters>
                <ThresholdFilter level="error" onMatch="DENY" onMismatch="NEUTRAL"/>
            </Filters>
            <PatternLayout pattern="${TEXT_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="100"/>
        </RollingFile>

        <!-- error 日志用于失败问题排查，是长期保留的核心诊断面。 -->
        <RollingFile name="errorFileAppender"
                     fileName="${LOG_HOME}/error.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${TEXT_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="100"/>
        </RollingFile>

        <!-- JSON error 日志便于后续对接日志采集与结构化分析工具。 -->
        <RollingFile name="errorJsonAppender"
                     fileName="${LOG_HOME}/error-json.log"
                     filePattern="${LOG_HOME}/error-json-%d{yyyy-MM-dd}-%i.log.gz">
            <JSONLayout compact="true" eventEol="true" properties="true"
                        locationInfo="false" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="100"/>
        </RollingFile>

        <!-- 审计日志独立落盘，避免业务运行日志与安全审计共用保留策略。 -->
        <RollingFile name="auditFileAppender"
                     fileName="${LOG_HOME}/audit.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/audit-%d{yyyy-MM-dd}-%i.log.gz"
                     filePermissions="rw-r-----">
            <PatternLayout pattern="${TEXT_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_HOME}" maxDepth="2">
                    <IfFileName glob="audit-*.log.gz"/>
                    <IfLastModified age="${AUDIT_RETENTION}"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- 业务审计统一走独立 logger；additivity=false 避免与业务运行日志重复。 -->
        <Logger name="team.carrypigeon.audit" level="info" additivity="false">
            <AppenderRef ref="auditFileAppender"/>
            <AppenderRef ref="consoleAppender" level="info"/>
        </Logger>

        <!-- Root 统一定义项目默认日志策略，具体业务模块不应各自复制一套日志基建规则。 -->
        <Root level="info">
            <AppenderRef ref="allFileAppender" level="all"/>
            <AppenderRef ref="consoleAppender" level="info"/>
            <AppenderRef ref="debugFileAppender" level="debug"/>
            <AppenderRef ref="infoFileAppender" level="info"/>
            <AppenderRef ref="warnFileAppender" level="warn"/>
            <AppenderRef ref="errorFileAppender" level="error"/>
            <AppenderRef ref="errorJsonAppender" level="error"/>
        </Root>

        <!-- 第三方框架默认降到 WARN，避免基础日志被框架噪声淹没。 -->
        <Logger name="org.springframework" level="WARN"/>
    </Loggers>
</Configuration>
