<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="CarryPigeonLogging">
    <Properties>
        <Property name="LOG_HOME">${sys:cp.log.home:-${env:CP_LOG_HOME:-./service-logs}}</Property>
        <Property name="RETENTION">${sys:cp.log.retention:-${env:CP_LOG_RETENTION:-30d}}</Property>
    </Properties>
    <Appenders>
        <!-- 每次启动只构建一个出口，前台由进程管理器采集，独立后台进程自行滚动归档。 -->
        <Select>
            <SystemPropertyArbiter propertyName="cp.log.output" propertyValue="file">
                <RollingFile name="application" fileName="${LOG_HOME}/application/app.jsonl"
                             filePattern="${LOG_HOME}/application/%d{yyyy-MM}/app-%d{yyyy-MM-dd}-%i.jsonl.gz"
                             filePermissions="rw-r-----">
                    <JsonLayout compact="true" eventEol="true" properties="true"/>
                    <Policies>
                        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                        <SizeBasedTriggeringPolicy size="100 MB"/>
                    </Policies>
                    <DefaultRolloverStrategy max="100">
                        <Delete basePath="${LOG_HOME}/application" maxDepth="2">
                            <IfFileName glob="*/app-*.jsonl.gz"/>
                            <IfLastModified age="${RETENTION}"/>
                        </Delete>
                    </DefaultRolloverStrategy>
                </RollingFile>
            </SystemPropertyArbiter>
            <!-- 本地交互调试可以显式选择文本，保留与 JSON 相同的上下文字段。 -->
            <SystemPropertyArbiter propertyName="cp.log.output" propertyValue="text">
                <Console name="application" target="SYSTEM_OUT">
                    <PatternLayout pattern="%d{ISO8601_OFFSET_DATE_TIME} %-5level %logger{48} %enc{%X}{CRLF} - %enc{%msg}{CRLF}%n%throwable"/>
                </Console>
            </SystemPropertyArbiter>
            <DefaultArbiter>
                <Console name="application" target="SYSTEM_OUT">
                    <JsonLayout compact="true" eventEol="true" properties="true"/>
                </Console>
            </DefaultArbiter>
        </Select>
    </Appenders>
    <Loggers>
        <!-- Spring Boot 会在 WARN 打印临时生成的开发密码，统一采集流只保留该组件的错误。 -->
        <Logger name="org.springframework.boot.autoconfigure.security.servlet.UserDetailsServiceAutoConfiguration" level="ERROR"/>
        <Logger name="org.springframework" level="WARN"/>
        <Root level="info"><AppenderRef ref="application"/></Root>
    </Loggers>
</Configuration>
